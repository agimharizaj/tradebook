# Copy this file to .env.local and fill in values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used to build OAuth redirect URLs. Locally this is http://localhost:3000
# In production set this to your Vercel URL, e.g. https://tradebook.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI assistant (/assistant). Free-tier key from Google AI Studio:
# https://aistudio.google.com/apikey
# Server-side only (read in /api/ai). Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key

# Account deletion (Profile -> Danger zone). Service-role key from
# Supabase Dashboard -> Project Settings -> API. Server-side only
# (read in /api/account/delete). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
