# Copy this file to .env.local and fill in values from your Supabase project.
# Supabase Dashboard -> Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used to build OAuth redirect URLs. Locally this is http://localhost:3000
# In production set this to your Vercel URL, e.g. https://tradebook.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sidekick AI assistant (/sidekick). Free-tier key from Google AI Studio:
# https://aistudio.google.com/apikey
# Server-side only (read in /api/ai). Never prefix with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key

# Account deletion (Profile -> Danger zone). Service-role key from
# Supabase Dashboard -> Project Settings -> API. Server-side only
# (read in /api/account/delete). NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backtest replay (/backtest): historical FX + metals candles. Free key
# (800 requests/day) from https://twelvedata.com - crypto works without it
# (keyless Binance). Server-side only (read in /api/candles).
TWELVE_DATA_API_KEY=your-twelvedata-key

# Optional: free fallback when Gemini's quota is exhausted (text questions only).
# Free account at https://openrouter.ai -> Keys -> Create Key. No card needed.
OPENROUTER_API_KEY=your-openrouter-key
